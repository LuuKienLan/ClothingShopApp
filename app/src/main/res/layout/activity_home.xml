<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <!-- User Avatar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/avatarCard"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="25dp"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/userAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                     />
            </androidx.cardview.widget.CardView>

            <!-- Greeting Text -->
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/avatarCard"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:text="Hi!"
                android:textColor="@color/dark_navy"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/quicksand_font" />

            <!-- Cart Icon with Badge -->
            <RelativeLayout
                android:id="@+id/cartContainer"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:id="@+id/cartIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_shopping_bag"
                    app:tint="@color/dark_navy" />

                <TextView
                    android:id="@+id/cartBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/badge_circle"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/quicksand_font" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12dp"
            android:text="Find the best fit for\nall your needs!"
            android:textColor="@color/dark_navy"
            android:textSize="40sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/quicksand_font"
            android:letterSpacing="-0.01" />

        <!-- Search Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/search_background"
            android:paddingHorizontal="18dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_search_outlined"
                app:tint="@color/gray_icon" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/filterIcon"
                android:layout_toEndOf="@id/searchIcon"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@null"
                android:hint="Search"
                android:textColor="@color/dark_navy"
                android:textColorHint="@color/hint_gray"
                android:textSize="15sp"
                android:fontFamily="@font/quicksand_font"
                android:inputType="text"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/filterIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_filter_lines"
                app:tint="@color/dark_navy" />
        </RelativeLayout>

        <!-- Products Grid -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingBottom="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <!-- Product 1 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/product1Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:background="@color/product_bg">

                                <ImageView
                                    android:id="@+id/product1Image"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                     />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/product1Favorite"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_margin="12dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="2dp"
                                    app:cardBackgroundColor="@color/white">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_heart_outline"
                                        app:tint="@color/dark_navy" />
                                </androidx.cardview.widget.CardView>
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cotton queen T"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="$43.00"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Product 2 (Selected with Blue Border) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/product2Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="@color/blue_select"
                        app:strokeWidth="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:background="@color/product_bg">

                                <ImageView
                                    android:id="@+id/product2Image"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                     />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/product2Favorite"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_margin="12dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="2dp"
                                    app:cardBackgroundColor="@color/white">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_heart_outline"
                                        app:tint="@color/dark_navy" />
                                </androidx.cardview.widget.CardView>
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cotton Style T"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="$40.50"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <!-- Product 3 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/product3Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:background="@color/product_bg">

                                <ImageView
                                    android:id="@+id/product3Image"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                     />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/product3Favorite"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_margin="12dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="2dp"
                                    app:cardBackgroundColor="@color/white">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_heart_outline"
                                        app:tint="@color/dark_navy" />
                                </androidx.cardview.widget.CardView>
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="White Plain T"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="$35.00"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Product 4 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/product4Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:background="@color/product_bg">

                                <ImageView
                                    android:id="@+id/product4Image"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/product4Favorite"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_margin="12dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="2dp"
                                    app:cardBackgroundColor="@color/white">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_heart_outline"
                                        app:tint="@color/dark_navy" />
                                </androidx.cardview.widget.CardView>
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Blue Classic T"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="$38.00"
                                    android:textColor="@color/dark_navy"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/quicksand_font" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"
        android:background="@color/white"
        app:elevation="12dp"
        app:itemIconSize="30dp"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />

</RelativeLayout>